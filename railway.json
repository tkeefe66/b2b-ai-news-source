{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "buildCommand": "npm run check && npm run test && npm run build" },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 0
  }
}
