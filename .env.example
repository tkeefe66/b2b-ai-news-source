# ============================================================
# Environment Variables — copy to Railway as individual vars
# ============================================================

# --- Node ---
NODE_ENV=production
RAILPACK_NODE_NPM_INSTALL="npm ci --include=dev"

# --- Database (Railway Postgres — copy the DATABASE_URL Railway provides) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI: Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- AI: Google Gemini ---
GEMINI_API_KEY=AIza...

# --- News: NewsAPI ---
NEWSAPI_KEY=your_newsapi_key_here

# --- Google Drive / Docs / Slides (OAuth2) ---
# TODO: Create a Google Cloud project, enable Drive + Docs + Slides APIs,
# create an OAuth2 credential, run the consent flow once, then paste the
# refresh token here. See server/google-drive.ts for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-railway-domain.up.railway.app/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# --- Session secret (generate a random string, e.g. `openssl rand -hex 32`) ---
SESSION_SECRET=

# --- Port (Railway injects this automatically — do NOT set manually on Railway) ---
# PORT=5000

# Morning Brief (push email)
RESEND_API_KEY=
BRIEF_RECIPIENTS=you@example.com
BRIEF_HOUR=7
BRIEF_TZ=America/Chicago
APP_URL=http://localhost:5000

# Private shared workspace sign-in (all approved emails have admin access).
# Register APP_BASE_URL + /api/auth/google/callback in your Google OAuth client.
# Google Drive credentials above are separate and do not grant workspace access.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
APP_BASE_URL=

# Persistent AI admission limits, not dollar or billed-token measurements.
AI_ENABLED=true
AI_MAX_CONCURRENT=6
AI_DAILY_MAX_CALLS=2000
AI_DAILY_MAX_UNITS=20000000
